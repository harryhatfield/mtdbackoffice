---
import Button from './Button.astro';
interface Props { title: string; text: string; ctaLabel: string; ctaHref: string; }
const { title, text, ctaLabel, ctaHref } = Astro.props;
---
<section id="book" class="band on-brand">
  <div class="container inner">
    <div class="copy">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <Button label={ctaLabel} href={ctaHref} variant="accent" size="lg" full />
  </div>
</section>

<style>
  .band { background: var(--brand); color: var(--on-brand); padding-block: var(--section-y); }
  .inner { display: flex; flex-wrap: wrap; gap: var(--space-8); align-items: center; justify-content: space-between; }
  .copy { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  h2 { color: var(--on-brand); font-size: 40px; line-height: 46px; letter-spacing: -0.8px; }
  p { font-size: 18px; line-height: 28px; color: var(--on-brand-muted); }
  @media (max-width: 899px) { h2 { font-size: var(--fs-h2); line-height: var(--lh-h2); } }
  .inner :global(.btn) { min-height: 56px; font-size: 17px; }
</style>
