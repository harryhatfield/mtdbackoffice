---
interface Props {
  eyebrow: string;
  title: string;
  price: string;
  unit: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
  featured?: boolean;
  ctaVariant?: 'primary' | 'secondary' | 'accent';
}
const { eyebrow, title, price, unit, description, ctaLabel, ctaHref, featured = false, ctaVariant } = Astro.props;
import Button from './Button.astro';
const variant = ctaVariant ?? (featured ? 'accent' : 'primary');
---
<article class:list={['card', { 'card--featured on-brand': featured }]}>
  <p class="card-eyebrow">{eyebrow}</p>
  <h3>{title}</h3>
  <p class="price">{price} <span class="unit">{unit}</span></p>
  <p>{description}</p>
  <div class="cta"><Button label={ctaLabel} href={ctaHref} variant={variant} full /></div>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex; flex-direction: column; gap: 14px;
    height: 100%;
  }
  .card--featured { background: var(--brand); border-color: var(--brand); color: var(--on-brand); }
  .card-eyebrow {
    font-size: var(--fs-eyebrow); line-height: var(--lh-eyebrow); font-weight: 600;
    letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--ink-muted);
  }
  .card--featured .card-eyebrow, .card--featured .unit { color: var(--on-brand-muted); }
  h3 { color: inherit; }
  .price { font-size: var(--fs-price); line-height: 1.2; font-weight: 800; letter-spacing: -1px; color: var(--brand); }
  .card--featured .price { color: var(--on-brand); }
  .unit { font-size: 15px; font-weight: 600; letter-spacing: 0; color: var(--ink-muted); }
  .cta { margin-top: auto; padding-top: var(--space-2); display: flex; }
  .cta :global(.btn) { flex: 1; }
  .card--featured :global(a:focus-visible) { outline-color: var(--on-brand); }
</style>
