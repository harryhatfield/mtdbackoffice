---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import DateList from '../components/DateList.astro';
import OfferCard from '../components/OfferCard.astro';
import Step from '../components/Step.astro';
import TrustBullet from '../components/TrustBullet.astro';
import FaqItem from '../components/FaqItem.astro';
import CtaBand from '../components/CtaBand.astro';
import { bookingHref } from '../config';

const dates = [
  { label: 'Quarter 1 update', date: '7 Aug 2027' },
  { label: 'Quarter 2 update', date: '7 Nov 2027' },
  { label: 'Quarter 3 update', date: '7 Feb 2028' },
  { label: 'Quarter 4 update', date: '7 May 2028' },
];
const steps = [
  { title: 'Free 30-minute admin check', text: "A call to see what's slowing you down and what MTD means for you." },
  { title: 'Fixed price, agreed up front', text: 'A one-page proposal the same day. No hourly surprises.' },
  { title: 'We set it up and train you', text: 'Software, bank feeds, receipts and reminders, then a recorded handover.' },
  { title: 'Optional monthly care', text: 'We keep it running and nudge you before every quarterly deadline.' },
];
const faqs = [
  { q: 'Do I need to switch accountant?', a: 'No. We set up the software and records; your accountant keeps doing your tax, and finds the job easier.' },
  { q: 'I earn under £30,000. Does this affect me?', a: 'From April 2028 the threshold drops to £20,000, so getting set up now saves a rush later.' },
  { q: 'Is my data safe?', a: 'You own every account. We get invited access, use business-grade tools, and remove our access when we finish.' },
  { q: 'How long does setup take?', a: 'Within 10 working days of payment and your onboarding form. Sprints take two weeks.' },
];
---
<Layout jsonLd>
  <section id="top" class="section--alt hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <Eyebrow text="Making Tax Digital · from 6 April 2027" />
        <h1>Your admin, sorted. MTD-ready before April.</h1>
        <p class="lead">From 6 April 2027, sole traders and landlords earning over £30,000 must keep digital records and send HMRC quarterly updates. We set it all up for you and take the busywork off your plate, so you get your evenings back.</p>
        <div class="hero-actions">
          <Button label="Book a free 30-minute admin check" href={bookingHref('hero')} size="lg" full />
          <a class="text-link" href="#prices">See prices</a>
        </div>
        <p class="trust-line">Fixed prices · HMRC-recognised software · Your accountant stays your accountant</p>
      </div>
      <aside class="hero-card" aria-labelledby="year-title">
        <h2 id="year-title" class="card-title">Your MTD year</h2>
        <DateList items={dates} />
        <p class="note">We set up the software and the records. Your accountant handles the tax.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container stack">
      <h2 class="prose">You didn't start a business to do admin.</h2>
      <p class="lead">Quotes written at 10pm. Receipts in the van. Invoices chased by memory. And now HMRC wants updates every quarter.</p>
    </div>
  </section>

  <section id="prices" class="section section--alt">
    <div class="container stack stack--lg">
      <h2>What we do</h2>
      <div class="offers">
        <div class="offer offer--1">
          <OfferCard eyebrow="Sole traders · landlords" title="MTD & Admin Setup" price="£495" unit="one-off, ex-VAT" description="HMRC-recognised software set up for your trade, bank feeds, receipts on your phone and automatic invoice reminders. Done in 10 working days." ctaLabel="Book a free check" ctaHref={bookingHref('offer-setup')} />
        </div>
        <div class="offer offer--2">
          <OfferCard featured eyebrow="Teams of 2–25" title="Automation Sprint" price="£1,500" unit="one-off, ex-VAT" description="We map your process and build three automations, from enquiry to quote to invoice to chase, plus an AI assistant trained on your own documents. Two weeks." ctaLabel="Talk to us about a sprint" ctaHref={bookingHref('offer-sprint')} />
        </div>
        <div class="offer offer--3">
          <OfferCard eyebrow="After setup" title="Ongoing care" price="£99" unit="/month, ex-VAT" description="We check everything monthly, fix what breaks and remind you before each quarter. Growth (£299) and Pro (£599) plans for busier teams." ctaLabel="Ask about care plans" ctaHref={bookingHref('offer-care')} ctaVariant="secondary" />
        </div>
      </div>
    </div>
  </section>

  <section id="how" class="section">
    <div class="container stack stack--lg">
      <h2>How it works</h2>
      <ol class="steps">
        {steps.map((s, i) => <Step number={i + 1} title={s.title} text={s.text} />)}
      </ol>
    </div>
  </section>

  <section class="section section--alt trust">
    <div class="container trust-inner">
      <div class="trust-copy">
        <h2>We don't do your tax. Your accountant does.</h2>
        <p>We work alongside local accountancy practices and only use business-grade tools that don't train AI on your data. You own every account; we get invited access and remove it when we finish.</p>
      </div>
      <ul class="bullets">
        <TrustBullet text="Fully insured" />
        <TrustBullet text="Fixed prices, agreed up front" />
        <TrustBullet text="Independent business, not part of HMRC" />
      </ul>
    </div>
  </section>

  <section id="faq" class="section">
    <div class="container faq-wrap">
      <h2>Questions</h2>
      {faqs.map((f, i) => <FaqItem question={f.q} answer={f.a} open={i === 0} />)}
    </div>
  </section>

  <CtaBand title="Get ready before the April rush." text="Book a free 30-minute admin check. No obligation, no jargon." ctaLabel="Book your free check" ctaHref={bookingHref('cta-band')} />
</Layout>

<style>
  .hero { padding-block: var(--hero-y); }
  .hero-inner { display: flex; flex-wrap: wrap; gap: var(--space-12); align-items: center; }
  .hero-copy { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: var(--space-6); align-items: flex-start; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; width: 100%; }
  .text-link { font-weight: 700; padding: 14px 8px; min-height: var(--target-min); display: inline-flex; align-items: center; }
  .trust-line { font-size: var(--fs-small); color: var(--ink-muted); }
  .hero-card {
    flex: 1 1 320px; min-width: 0; background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--radius-lg); padding: 28px; display: flex; flex-direction: column; gap: var(--space-4);
  }
  .card-title {
    font-size: var(--fs-eyebrow); line-height: var(--lh-eyebrow); font-weight: 600; letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase; color: var(--ink-muted);
  }
  .note { background: var(--brand); color: var(--on-brand); border-radius: var(--radius-md); padding: 14px 16px; font-size: var(--fs-small); line-height: 21px; }

  .stack { display: flex; flex-direction: column; gap: var(--space-4); align-items: flex-start; }
  .stack--lg { gap: var(--space-8); align-items: stretch; }

  .offers { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .offer { min-width: 0; }
  @media (max-width: 899px) {
    .offers { grid-template-columns: repeat(2, 1fr); }
    .offer--3 { grid-column: 1 / -1; }
  }
  @media (max-width: 599px) {
    .offers { grid-template-columns: 1fr; }
    .offer--2 { order: -1; }
  }

  .steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-6); }
  @media (max-width: 899px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 599px) { .steps { grid-template-columns: 1fr; } }

  .trust { padding-block: var(--space-16); }
  .trust-inner { display: flex; flex-wrap: wrap; gap: var(--space-8); align-items: center; justify-content: space-between; }
  .trust-copy { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  .trust-copy h2 { font-size: 28px; line-height: 34px; letter-spacing: 0; }
  .bullets { flex: 1 1 280px; list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }

  .faq-wrap { max-width: 820px; display: flex; flex-direction: column; gap: var(--space-4); }
  .faq-wrap h2 { margin-bottom: var(--space-2); }
</style>
